<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Flux v3 obligatoire : le flux v2 ne publie pas les vulnérabilités, et le contrôle répondrait à tort que tout va bien. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<Window x:Class="LegendaryPen.App.PdfSignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindow}"
        Title="Signer un PDF"
        Width="980"
        Height="780"
        MinWidth="720"
        MinHeight="420"
        ResizeMode="CanResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="14,6,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False">
            <Button Content="Ouvrir un PDF" MinWidth="110" Click="OnOpenClicked" />

            <Button x:Name="PreviousButton"
                    Content="&#xE76B;"
                    FontFamily="Segoe MDL2 Assets"
                    Margin="14,0,0,0"
                    MinWidth="32"
                    IsEnabled="False"
                    ToolTip="Page précédente"
                    AutomationProperties.Name="Page précédente"
                    Click="OnPreviousClicked" />
            <TextBlock x:Name="PageLabel" Margin="8,0" MinWidth="70" TextAlignment="Center" VerticalAlignment="Center" />
            <Button x:Name="NextButton"
                    Content="&#xE76C;"
                    FontFamily="Segoe MDL2 Assets"
                    MinWidth="32"
                    IsEnabled="False"
                    ToolTip="Page suivante"
                    AutomationProperties.Name="Page suivante"
                    Click="OnNextClicked" />

            <Button x:Name="SaveButton"
                    Content="Enregistrer le PDF signé"
                    DockPanel.Dock="Right"
                    MinWidth="150"
                    IsEnabled="False"
                    Click="OnSaveClicked" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,8,0,8" LastChildFill="False">
            <Button x:Name="DrawButton"
                    Content="Tracer une signature"
                    MinWidth="140"
                    IsEnabled="False"
                    Click="OnDrawClicked" />
            <Button x:Name="PlaceSavedButton"
                    Content="Poser ma signature"
                    Margin="8,0,0,0"
                    MinWidth="130"
                    IsEnabled="False"
                    Click="OnPlaceSavedClicked" />
            <Button x:Name="RemoveButton"
                    Content="Retirer de la page"
                    Margin="8,0,0,0"
                    MinWidth="120"
                    IsEnabled="False"
                    ToolTip="Retire la signature sélectionnée (Suppr)"
                    Click="OnRemoveClicked" />
            <Button x:Name="ForgetButton"
                    Content="Oublier ma signature"
                    DockPanel.Dock="Right"
                    MinWidth="130"
                    ToolTip="Supprime la signature mémorisée sur cet ordinateur"
                    Click="OnForgetClicked" />
        </DockPanel>

        <Border Grid.Row="2" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="EmptyHint"
                           Text="Ouvrez un PDF pour commencer. Le fichier d'origine n'est jamais modifié."
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <ScrollViewer x:Name="Viewer"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              SizeChanged="OnViewerSizeChanged">
                    <Grid x:Name="PageHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" Visibility="Collapsed">
                        <Image x:Name="PageImage" Stretch="Fill" />
                        <Canvas x:Name="SignatureLayer"
                                Background="Transparent"
                                ClipToBounds="True"
                                MouseLeftButtonDown="OnLayerPressed" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Signature visuelle : elle n'a pas la valeur d'une signature électronique certifiée." />
    </Grid>
</Window>

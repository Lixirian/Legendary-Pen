<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>LegendaryPen.App</RootNamespace>
    <AssemblyName>LegendaryPen</AssemblyName>
    <Product>Legendary Pen</Product>
    <AssemblyTitle>Legendary Pen</AssemblyTitle>
    <Version>0.8.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>legendary-pen.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms ne sert qu'à l'icône de notification : ses noms ne doivent pas entrer en conflit avec WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="legendary-pen.ico" />
    <ProjectReference Include="..\LegendaryPen.Core\LegendaryPen.Core.csproj" />
  </ItemGroup>

</Project>

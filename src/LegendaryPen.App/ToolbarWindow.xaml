<Window x:Class="LegendaryPen.App.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Legendary Pen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Icon="legendary-pen.ico"
        ShowActivated="False"
        Topmost="True"
        Opacity="0"
        PreviewMouseDown="OnToolbarPressed"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <SolidColorBrush x:Key="HoverBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#FFE53935" />

        <Style x:Key="ToolButtonBase" TargetType="ButtonBase">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonBase}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring"
                                     Width="28"
                                     Height="28"
                                     StrokeThickness="2"
                                     Stroke="Transparent" />
                            <Ellipse Width="20"
                                     Height="20"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="#66FFFFFF"
                                     StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ToolButtonBase}" />

        <Style x:Key="WaveButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu du bouton Présentation : mêmes couleurs que le menu de l'icône de notification. -->
        <Style x:Key="PresentationMenuStyle" TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#FF202124" BorderBrush="#FF46474B" BorderThickness="1" Padding="2">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresentationMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Surface" Background="Transparent" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Visibility="Hidden"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Margin="24,0,0,0"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#FFA8A8AE"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFE53935" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
    <Button x:Name="ExpandButton"
            Style="{StaticResource WaveButtonStyle}"
            Visibility="Collapsed"
            ToolTip="Déplier la barre"
            AutomationProperties.Name="Déplier la barre"
            Click="OnExpandClicked">
        <Grid>
            <Path x:Name="WavePath"
                  Data="M0,26 C34,26 36,2 64,2 C92,2 94,26 128,26 Z"
                  Fill="#F0202124"
                  Stroke="#55FFFFFF"
                  StrokeThickness="1" />
            <Grid x:Name="WaveContent"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Image x:Name="ExpandIcon"
                       Width="16"
                       Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Ellipse x:Name="ExpandBadge"
                         Width="8"
                         Height="8"
                         Margin="0,-2,-4,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="#FFFF5252"
                         Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Button>
    <Border x:Name="BarSurface" Background="#F0202124" Padding="4">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel x:Name="ToolbarPanel">
            <Border x:Name="Grip"
                    Background="Transparent"
                    Cursor="SizeAll"
                    ToolTip="Déplacer la barre"
                    MouseLeftButtonDown="OnGripPressed">
                <TextBlock x:Name="GripGlyph"
                           FontFamily="Segoe MDL2 Assets"
                           Foreground="#99FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <ToggleButton x:Name="MouseButton"
                          Content="&#xE962;"
                          ToolTip="Mode Souris (Échap)"
                          AutomationProperties.Name="Mode Souris"
                          Checked="OnMouseToggled"
                          Unchecked="OnMouseToggled" />
            <ToggleButton x:Name="PenButton"
                          Content="&#xE76D;"
                          Tag="Pen"
                          ToolTip="Stylo (P)"
                          AutomationProperties.Name="Stylo"
                          Checked="OnToolToggled"
                          Unchecked="OnToolToggled" />
            <ToggleButton x:Name="HighlighterButton"
                          Content="&#xE7E6;"
                          Tag="Highlighter"
                          ToolTip="Surligneur (H)"
                          AutomationProperties.Name="Surligneur"
                          Checked="OnToolToggled"
                          Unchecked="OnToolToggled" />
            <ToggleButton x:Name="EraserButton"
                          Content="&#xE75C;"
                          Tag="Eraser"
                          ToolTip="Gomme (E)"
                          AutomationProperties.Name="Gomme"
                          Checked="OnToolToggled"
                          Unchecked="OnToolToggled" />
            <ToggleButton x:Name="LineButton"
                          Tag="Line"
                          ToolTip="Ligne (L). Maj : par pas de 45°"
                          AutomationProperties.Name="Ligne"
                          Checked="OnToolToggled"
                          Unchecked="OnToolToggled">
                <Path Data="M2,14 L14,2" Stroke="White" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
            </ToggleButton>
            <ToggleButton x:Name="ArrowButton"
                          Tag="Arrow"
                          ToolTip="Flèche (A). Maj : par pas de 45°"
                          AutomationProperties.Name="Flèche"
                          Checked="OnToolToggled"
                          Unchecked="OnToolToggled">
                <Path Data="M2,14 L14,2 M7,2 L14,2 L14,9" Stroke="White" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
            </ToggleButton>
            <ToggleButton x:Name="RectangleButton"
                          Tag="Rectangle"
                          ToolTip="Rectangle (R). Maj : carré"
                          AutomationProperties.Name="Rectangle"
                          Checked="OnToolToggled"
                          Unchecked="OnToolToggled">
                <Rectangle Width="16" Height="12" Stroke="White" StrokeThickness="2" />
            </ToggleButton>
            <ToggleButton x:Name="EllipseButton"
                          Tag="Ellipse"
                          ToolTip="Ellipse (O). Maj : cercle"
                          AutomationProperties.Name="Ellipse"
                          Checked="OnToolToggled"
                          Unchecked="OnToolToggled">
                <Ellipse Width="16" Height="12" Stroke="White" StrokeThickness="2" />
            </ToggleButton>
            <ToggleButton x:Name="TextButton"
                          Content="&#xE8D2;"
                          Tag="Text"
                          ToolTip="Texte (T). Échap ou clic ailleurs : valider"
                          AutomationProperties.Name="Texte"
                          Checked="OnToolToggled"
                          Unchecked="OnToolToggled" />

            <Border Tag="Separator" Background="#44FFFFFF" />

            <StackPanel x:Name="SwatchPanel" />
            <Button Content="&#xE710;"
                    ToolTip="Autre couleur"
                    AutomationProperties.Name="Autre couleur"
                    Click="OnMoreColorsClicked" />
            <Button x:Name="PreviousColorButton"
                    IsEnabled="False"
                    AutomationProperties.Name="Couleur précédente"
                    Click="OnPreviousColorClicked">
                <Ellipse x:Name="PreviousColorDot" Width="16" Height="16" Stroke="White" StrokeThickness="1" />
            </Button>

            <Border Tag="Separator" Background="#44FFFFFF" />

            <ToggleButton x:Name="SmallSizeButton"
                          Tag="0"
                          ToolTip="Trait fin"
                          AutomationProperties.Name="Trait fin"
                          Checked="OnSizePresetToggled"
                          Unchecked="OnSizePresetToggled">
                <Ellipse Width="4" Height="4" Fill="White" />
            </ToggleButton>
            <ToggleButton x:Name="MediumSizeButton"
                          Tag="1"
                          ToolTip="Trait moyen"
                          AutomationProperties.Name="Trait moyen"
                          Checked="OnSizePresetToggled"
                          Unchecked="OnSizePresetToggled">
                <Ellipse Width="8" Height="8" Fill="White" />
            </ToggleButton>
            <ToggleButton x:Name="LargeSizeButton"
                          Tag="2"
                          ToolTip="Trait épais"
                          AutomationProperties.Name="Trait épais"
                          Checked="OnSizePresetToggled"
                          Unchecked="OnSizePresetToggled">
                <Ellipse Width="14" Height="14" Fill="White" />
            </ToggleButton>

            <Border Tag="Separator" Background="#44FFFFFF" />

            <Button x:Name="UndoButton"
                    Content="&#xE7A7;"
                    ToolTip="Annuler (Ctrl+Z)"
                    AutomationProperties.Name="Annuler la dernière action"
                    Click="OnUndoClicked" />
            <Button x:Name="RedoButton"
                    Content="&#xE7A6;"
                    ToolTip="Rétablir (Ctrl+Y)"
                    AutomationProperties.Name="Rétablir"
                    Click="OnRedoClicked" />
            <Button x:Name="ClearButton"
                    Content="&#xE74D;"
                    ToolTip="Tout effacer (Suppr)"
                    AutomationProperties.Name="Tout effacer"
                    Click="OnClearClicked" />
            <Button x:Name="RecordButton"
                    ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="Enregistrer l'écran"
                    Click="OnRecordClicked">
                <Grid>
                    <TextBlock x:Name="RecordGlyph" Text="&#xE7C8;" Foreground="#FFFF5252" />
                    <Viewbox x:Name="RecordTime" StretchDirection="DownOnly" Margin="2,0" Visibility="Collapsed">
                        <TextBlock x:Name="RecordTimeText" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" />
                    </Viewbox>
                </Grid>
            </Button>

            <Border Tag="Separator" Background="#44FFFFFF" />

            <Button x:Name="UpdateButton"
                    Visibility="Collapsed"
                    ToolTip="Mise à jour disponible"
                    AutomationProperties.Name="Mise à jour disponible"
                    Click="OnUpdateClicked">
                <Grid>
                    <TextBlock Text="&#xE896;" />
                    <Ellipse Width="9"
                             Height="9"
                             Margin="0,-4,-6,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Fill="#FFFF5252" />
                </Grid>
            </Button>
            <Button x:Name="SecondRowButton"
                    AutomationProperties.Name="Masquer la deuxième ligne"
                    Click="OnSecondRowClicked">
                <Grid>
                    <TextBlock x:Name="SecondRowGlyph" />
                    <Ellipse x:Name="SecondRowBadge"
                             Width="9"
                             Height="9"
                             Margin="0,-4,-6,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Fill="#FFFF5252"
                             Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Content="&#xE8BB;"
                    ToolTip="Quitter"
                    AutomationProperties.Name="Quitter"
                    Click="OnQuitClicked" />
        </WrapPanel>
        <WrapPanel x:Name="SecondRow">
            <ToggleButton x:Name="FadeButton"
                          Content="&#xE823;"
                          ToolTip="Encre évanescente (F)"
                          AutomationProperties.Name="Encre évanescente"
                          Checked="OnFadeToggled"
                          Unchecked="OnFadeToggled" />
            <ToggleButton x:Name="WhiteboardButton"
                          Tag="Whiteboard"
                          ToolTip="Tableau blanc (W)"
                          AutomationProperties.Name="Tableau blanc"
                          Checked="OnBoardToggled"
                          Unchecked="OnBoardToggled">
                <Rectangle Width="18" Height="13" Fill="White" />
            </ToggleButton>
            <ToggleButton x:Name="BlackboardButton"
                          Tag="Blackboard"
                          ToolTip="Tableau noir (B)"
                          AutomationProperties.Name="Tableau noir"
                          Checked="OnBoardToggled"
                          Unchecked="OnBoardToggled">
                <Rectangle Width="18" Height="13" Fill="#FF1C1C1E" Stroke="White" StrokeThickness="1" />
            </ToggleButton>

            <Border Tag="Separator" Background="#44FFFFFF" />

            <Slider x:Name="SizeSlider"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Focusable="False"
                    Minimum="1"
                    Maximum="40"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True"
                    ToolTip="Taille du trait"
                    AutomationProperties.Name="Taille du trait"
                    ValueChanged="OnSizeSliderChanged" />

            <Border Tag="Separator" Background="#44FFFFFF" />

            <ToggleButton x:Name="HideButton"
                          Content="&#xED1A;"
                          ToolTip="Masquer les annotations (V)"
                          AutomationProperties.Name="Masquer les annotations"
                          Checked="OnHideToggled"
                          Unchecked="OnHideToggled" />
            <Button x:Name="LayersButton"
                    Content="&#xE81E;"
                    ToolTip="Calques"
                    AutomationProperties.Name="Calques"
                    Click="OnLayersClicked" />
            <Button x:Name="CaptureButton"
                    Content="&#xE722;"
                    AutomationProperties.Name="Capture d'écran"
                    Click="OnCaptureClicked" />
            <Button x:Name="SignPdfButton"
                    Content="&#xEE56;"
                    ToolTip="Signer un PDF"
                    AutomationProperties.Name="Signer un PDF"
                    Click="OnSignPdfClicked" />
            <Button x:Name="PresentationButton"
                    Content="&#xE7F4;"
                    ToolTip="Présentation"
                    AutomationProperties.Name="Présentation"
                    Click="OnPresentationClicked" />
            <Button x:Name="OrientationButton"
                    Content="&#xE7AD;"
                    AutomationProperties.Name="Changer l'orientation de la barre"
                    Click="OnOrientationClicked" />

            <Border Tag="Separator" Background="#44FFFFFF" />

            <Button Content="&#xE713;"
                    ToolTip="Réglages"
                    AutomationProperties.Name="Réglages"
                    Click="OnSettingsClicked" />
        </WrapPanel>
        </Grid>
    </Border>
    </Grid>
</Window>

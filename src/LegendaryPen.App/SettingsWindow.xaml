<Window x:Class="LegendaryPen.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réglages de Legendary Pen"
        Width="600"
        Height="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="legendary-pen.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText"
                       Foreground="#C62828"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkButton" Content="Enregistrer" MinWidth="96" Padding="8,4" IsDefault="True" Click="OnOkClicked" />
                <Button Content="Annuler" MinWidth="96" Padding="8,4" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>

        <TabControl>
            <TabItem Header="Général">
                <StackPanel Margin="12">
                    <TextBlock Text="Démarrage" Style="{StaticResource Section}" Margin="0,0,0,6" />
                    <CheckBox x:Name="StartupBox" Content="Lancer Legendary Pen à l'ouverture de session" />
                    <TextBlock x:Name="StartupNote"
                               Text="Disponible uniquement depuis la version installée."
                               Foreground="#666666"
                               Visibility="Collapsed" />

                    <TextBlock Text="Barre d'outils" Style="{StaticResource Section}" />
                    <TextBlock Text="Une barre attachée à un bord se replie après :" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="CollapseText" DockPanel.Dock="Right" Width="70" TextAlignment="Right" />
                        <Slider x:Name="CollapseSlider"
                                Minimum="2"
                                Maximum="60"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Délai de repli"
                                ValueChanged="OnSliderChanged" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Dessin">
                <StackPanel Margin="12">
                    <TextBlock Text="Saisie" Style="{StaticResource Section}" Margin="0,0,0,6" />
                    <CheckBox x:Name="WheelBox" Content="La molette change la taille du trait en mode Dessin" />
                    <CheckBox x:Name="PressureBox" Content="Tenir compte de la pression du stylet" />

                    <TextBlock Text="Encre évanescente" Style="{StaticResource Section}" />
                    <TextBlock Text="Délai avant la disparition :" />
                    <DockPanel Margin="0,6,0,8">
                        <TextBlock x:Name="FadeDelayText" DockPanel.Dock="Right" Width="70" TextAlignment="Right" />
                        <Slider x:Name="FadeDelaySlider"
                                Minimum="1"
                                Maximum="30"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Délai avant la disparition"
                                ValueChanged="OnSliderChanged" />
                    </DockPanel>
                    <TextBlock Text="Durée du fondu :" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="FadeDurationText" DockPanel.Dock="Right" Width="70" TextAlignment="Right" />
                        <Slider x:Name="FadeDurationSlider"
                                Minimum="0.2"
                                Maximum="5"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Durée du fondu"
                                ValueChanged="OnSliderChanged" />
                    </DockPanel>

                    <TextBlock Text="Tableaux" Style="{StaticResource Section}" />
                    <CheckBox x:Name="BoardScreenBox" Content="Afficher le tableau uniquement sur l'écran de la barre d'outils" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Capture">
                <StackPanel Margin="12">
                    <TextBlock Text="Après une capture" Style="{StaticResource Section}" Margin="0,0,0,6" />
                    <RadioButton x:Name="FolderRadio" Content="Enregistrer dans un dossier" GroupName="Destination" />
                    <RadioButton x:Name="ClipboardRadio" Content="Copier dans le presse-papiers" GroupName="Destination" />
                    <RadioButton x:Name="AskRadio" Content="Demander où enregistrer à chaque fois" GroupName="Destination" />

                    <TextBlock Text="Dossier" Style="{StaticResource Section}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Parcourir…" Margin="8,0,0,0" Padding="10,2" Click="OnBrowseClicked" />
                        <TextBox x:Name="FolderBox" Padding="4" AutomationProperties.Name="Dossier des captures" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Raccourcis">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Text="Cliquez sur un champ puis appuyez sur la combinaison souhaitée. Sauf mention contraire, un raccourci n'est actif qu'en mode Dessin." />
                    <Button DockPanel.Dock="Bottom"
                            Content="Rétablir les raccourcis par défaut"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Padding="10,2"
                            Click="OnResetHotkeysClicked" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HotkeyRows" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
